{
  "name": "@sshirkit/dsh-orchestrator",
  "version": "0.8.7",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Main agent that plans and delegates work; orchestrate fans out with pipelines and structured results; long-running workers are supervised by reading session logs",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/images"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.2.3-0"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "orchestrator",
    "subagent",
    "planning"
  ],
  "license": "MIT",
  "author": "SShiRkiT (https://github.com/SShiRkiT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SShiRkiT/dsh-orchestrator.git"
  },
  "homepage": "https://github.com/SShiRkiT/dsh-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/SShiRkiT/dsh-orchestrator/issues"
  }
}
